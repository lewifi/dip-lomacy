{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dip-lomacy",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "dip-lomacy.com", "custom_domain": true },
    { "pattern": "www.dip-lomacy.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GLOBAL_WAR",
        "class_name": "GlobalWarDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GlobalWarDO"
      ]
    }
  ]
}
