{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dip-lomacy",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "dip-lomacy.com", "custom_domain": true },
    { "pattern": "www.dip-lomacy.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "triggers": {
    // Every minute for ambient heartbeat; hourly reminder self-gates in scheduled().
    "crons": ["* * * * *"]
  },
  "vars": {
    // VAPID public key is safe to expose. Private key is a secret:
    //   npx wrangler secret put VAPID_PRIVATE_KEY
    "VAPID_PUBLIC_KEY": "BD0gLOQ8fNtLkTwMp3YWmi7yKQAruePiNMToPWK6A6b6g--AQPmoa26NRqgv--82dNzDqGAWx6bb_peSvuRoSb0",
    "VAPID_SUBJECT": "mailto:lewi.hirvela@gmail.com"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GLOBAL_WAR",
        "class_name": "GlobalWarDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GlobalWarDO"
      ]
    }
  ]
}
